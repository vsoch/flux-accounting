# Example flux-accounting configuration file.
#
# Every key is optional. Usage, priority, and queue values are defaults used
# by "flux account create-db". Resource quotas are read at runtime by the
# resource quotas jobtap plugin when this file is loaded by the broker.
# A customized file may therefore be both installed in the broker config path
# and passed to "flux account create-db" with --config-path.
#
# Durations may be expressed in Flux Standard Duration (e.g. "7d") or as
# a number of seconds.

# job usage calculation
[accounting.usage]
# the amount of time before job usage gets reset to 0
#reset-period = "28d"

# the contribution of historical job usage on the composite usage value
#decay-half-life = "7d"

# the amount of decay to apply to historical usage
#decay-factor = 0.5

# per-resource-type weights applied when calculating job usage
[accounting.usage.weights]
#node = 1.0
#core = 0.0
#gpu = 0.0

# the weights for each priority factor used by the multi-factor
# priority plugin
[accounting.priority.factors]
#fairshare = 100000
#queue = 10000
#bank = 0
#urgency = 1000

[accounting.queues]
# reject jobs submitted to queues not defined in the queue_table
#deny-unknown = false

# concurrent resource quotas applied to each user across all banks
[accounting.quotas.user]
#quantum = 2
